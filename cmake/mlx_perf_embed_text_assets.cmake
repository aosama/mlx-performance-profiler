# Embeds text files (the graph view's JavaScript and CSS) into a generated
# C++ source, one function per file returning its bytes as a string_view.
#
# Why embed: a report must be one self-contained HTML file that opens from
# disk, offline, and can be attached or archived as is, so the library that
# writes it carries the files inside itself instead of installing them.
#
# Why hex bytes rather than raw string literals: the vendored, minified
# libraries are single lines of several hundred KB holding any character,
# including non-ASCII ones. Splitting them into compiler-sized raw literals
# could cut a UTF-8 sequence in two or meet the delimiter; a byte array has
# neither problem and compiles in about a second.
#
# Run in script mode (see CMakeLists.txt):
#   cmake -DOUTPUT_FILE=<generated .cpp> -DHEADER_NAME=<header to include>
#         -DASSET_FUNCTIONS=<fn1|fn2> -DASSET_FILES=<path1|path2>
#         -P mlx_perf_embed_text_assets.cmake
# The lists are '|'-separated because a custom command splits its arguments
# at ';'.

string(REPLACE "|" ";" ASSET_FUNCTIONS "${ASSET_FUNCTIONS}")
string(REPLACE "|" ";" ASSET_FILES "${ASSET_FILES}")
list(LENGTH ASSET_FUNCTIONS function_count)
list(LENGTH ASSET_FILES file_count)
if(NOT function_count EQUAL file_count OR function_count EQUAL 0)
  message(FATAL_ERROR "ASSET_FUNCTIONS and ASSET_FILES must be non-empty lists of equal length")
endif()

set(generated_source "// Generated by cmake/mlx_perf_embed_text_assets.cmake. Do not edit.\n")
string(APPEND generated_source "#include \"${HEADER_NAME}\"\n\nnamespace mlx_perf {\nnamespace {\n\n")
set(function_definitions "")
math(EXPR last_asset_index "${function_count} - 1")
foreach(asset_index RANGE ${last_asset_index})
  list(GET ASSET_FUNCTIONS ${asset_index} function_name)
  list(GET ASSET_FILES ${asset_index} asset_path)
  file(READ "${asset_path}" asset_hex HEX)
  string(LENGTH "${asset_hex}" hex_length)
  math(EXPR byte_count "${hex_length} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," byte_initializers "${asset_hex}")
  string(APPEND generated_source
         "// ${asset_path}\nconst unsigned char ${function_name}_bytes[] = {${byte_initializers}};\n\n")
  string(APPEND function_definitions
         "std::string_view ${function_name}() {\n"
         "  return {reinterpret_cast<const char*>(${function_name}_bytes), ${byte_count}};\n}\n\n")
endforeach()
string(APPEND generated_source "} // namespace\n\n${function_definitions}} // namespace mlx_perf\n")

# Rewrite only on change, so an unchanged asset does not recompile the library.
set(previous_source "")
if(EXISTS "${OUTPUT_FILE}")
  file(READ "${OUTPUT_FILE}" previous_source)
endif()
if(NOT previous_source STREQUAL generated_source)
  file(WRITE "${OUTPUT_FILE}" "${generated_source}")
endif()
