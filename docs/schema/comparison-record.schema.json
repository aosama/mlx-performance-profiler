{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aosama/mlx-performance-profiler/blob/main/docs/schema/comparison-record.schema.json",
  "title": "mlx-performance-profiler comparison record, schema version 1",
  "description": "Written as <report_file_base>.json by mlx_perf_compare_to_report: the verdict and every round's numbers. Per-node detail is in each variant's own measurement file, which this record names.",
  "type": "object",
  "required": [
    "baseline",
    "candidate",
    "kind",
    "metrics",
    "output_agreement",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "comparison"
    },
    "baseline": {
      "type": "object",
      "required": [
        "measurement_file",
        "variant_name"
      ],
      "properties": {
        "variant_name": {
          "type": "string"
        },
        "measurement_file": {
          "type": "string",
          "description": "That variant's measurement file, relative to this one."
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "measurement_file",
        "variant_name"
      ],
      "properties": {
        "variant_name": {
          "type": "string"
        },
        "measurement_file": {
          "type": "string",
          "description": "That variant's measurement file, relative to this one."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "gpu_span_us",
        "host_submission_us",
        "job_wall_us"
      ],
      "properties": {
        "job_wall_us": {
          "type": "object",
          "required": [
            "baseline",
            "candidate",
            "difference_interval_us",
            "median_difference_us",
            "relative_difference",
            "round_count",
            "round_difference_us",
            "rounds_candidate_faster",
            "sign_test_p_value",
            "verdict"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "round_difference_us": {
              "type": "object",
              "required": [
                "max",
                "median",
                "min"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "Per-round candidate - baseline differences."
            },
            "difference_interval_us": {
              "type": "object",
              "required": [
                "coverage",
                "high",
                "low"
              ],
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                },
                "coverage": {
                  "type": "number"
                }
              },
              "description": "Distribution-free interval for the median per-round difference (12 rounds: 3rd and 10th smallest, coverage 0.961)."
            },
            "sign_test_p_value": {
              "type": "number",
              "description": "Exact two-sided sign test over non-zero per-round differences."
            },
            "median_difference_us": {
              "type": "number",
              "description": "Median per-round difference; negative means the candidate is faster."
            },
            "relative_difference": {
              "type": "number",
              "description": "median_difference_us / baseline median (0 when that is 0)."
            },
            "verdict": {
              "enum": [
                "candidate_faster",
                "candidate_slower",
                "within_spread"
              ],
              "description": "candidate_faster when the whole interval lies below zero, candidate_slower when above, otherwise within_spread: no result."
            },
            "rounds_candidate_faster": {
              "type": "integer"
            },
            "round_count": {
              "type": "integer"
            }
          }
        },
        "gpu_span_us": {
          "type": "object",
          "required": [
            "baseline",
            "candidate",
            "difference_interval_us",
            "median_difference_us",
            "relative_difference",
            "round_count",
            "round_difference_us",
            "rounds_candidate_faster",
            "sign_test_p_value",
            "verdict"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "round_difference_us": {
              "type": "object",
              "required": [
                "max",
                "median",
                "min"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "Per-round candidate - baseline differences."
            },
            "difference_interval_us": {
              "type": "object",
              "required": [
                "coverage",
                "high",
                "low"
              ],
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                },
                "coverage": {
                  "type": "number"
                }
              },
              "description": "Distribution-free interval for the median per-round difference (12 rounds: 3rd and 10th smallest, coverage 0.961)."
            },
            "sign_test_p_value": {
              "type": "number",
              "description": "Exact two-sided sign test over non-zero per-round differences."
            },
            "median_difference_us": {
              "type": "number",
              "description": "Median per-round difference; negative means the candidate is faster."
            },
            "relative_difference": {
              "type": "number",
              "description": "median_difference_us / baseline median (0 when that is 0)."
            },
            "verdict": {
              "enum": [
                "candidate_faster",
                "candidate_slower",
                "within_spread"
              ],
              "description": "candidate_faster when the whole interval lies below zero, candidate_slower when above, otherwise within_spread: no result."
            },
            "rounds_candidate_faster": {
              "type": "integer"
            },
            "round_count": {
              "type": "integer"
            }
          }
        },
        "host_submission_us": {
          "type": "object",
          "required": [
            "baseline",
            "candidate",
            "difference_interval_us",
            "median_difference_us",
            "relative_difference",
            "round_count",
            "round_difference_us",
            "rounds_candidate_faster",
            "sign_test_p_value",
            "verdict"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "round_difference_us": {
              "type": "object",
              "required": [
                "max",
                "median",
                "min"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "Per-round candidate - baseline differences."
            },
            "difference_interval_us": {
              "type": "object",
              "required": [
                "coverage",
                "high",
                "low"
              ],
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                },
                "coverage": {
                  "type": "number"
                }
              },
              "description": "Distribution-free interval for the median per-round difference (12 rounds: 3rd and 10th smallest, coverage 0.961)."
            },
            "sign_test_p_value": {
              "type": "number",
              "description": "Exact two-sided sign test over non-zero per-round differences."
            },
            "median_difference_us": {
              "type": "number",
              "description": "Median per-round difference; negative means the candidate is faster."
            },
            "relative_difference": {
              "type": "number",
              "description": "median_difference_us / baseline median (0 when that is 0)."
            },
            "verdict": {
              "enum": [
                "candidate_faster",
                "candidate_slower",
                "within_spread"
              ],
              "description": "candidate_faster when the whole interval lies below zero, candidate_slower when above, otherwise within_spread: no result."
            },
            "rounds_candidate_faster": {
              "type": "integer"
            },
            "round_count": {
              "type": "integer"
            }
          }
        }
      }
    },
    "output_agreement": {
      "type": "object",
      "required": [
        "max_absolute_difference",
        "output_count"
      ],
      "properties": {
        "output_count": {
          "type": "integer"
        },
        "max_absolute_difference": {
          "type": [
            "number",
            "null"
          ],
          "description": "Largest element-wise difference between the variants' outputs, as float32; null when not finite."
        }
      }
    }
  }
}
