              "has_launch_unable_to_fill_gpu": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether any launch had fewer threadgroups than GPU cores; null when the core count is unknown."
              }
            }
          },
          "description": "The observed run's launches grouped by Metal function."
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "duration_us",
        "gpu_busy_us",
        "gpu_idle_us"
      ],
      "properties": {
        "duration_us": {
          "type": "object",
          "required": [
            "baseline",
            "candidate",
            "difference_interval_us",
            "median_difference_us",
            "relative_difference",
            "round_count",
            "round_difference_us",
            "rounds_candidate_faster",
            "sign_test_p_value",
            "verdict"
          ],
          "properties": {
            "baseline": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "candidate": {
              "type": "object",
              "required": [
                "lower_quartile",
                "max",
                "median",
                "min",
                "samples",
                "upper_quartile"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "lower_quartile": {
                  "type": "number"
                },
                "upper_quartile": {
                  "type": "number"
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "round_difference_us": {
              "type": "object",
              "required": [
                "max",
                "median",
                "min"
              ],
              "properties": {
                "median": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "Per-round candidate - baseline differences."
            },
            "difference_interval_us": {
              "type": "object",
              "required": [
                "coverage",
                "high",
                "low"
              ],
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                },
                "coverage": {
                  "type": "number"
                }
              },
              "description": "Distribution-free interval for the median per-round difference (12 rounds: 3rd and 10th smallest, coverage 0.961)."
            },
            "sign_test_p_value": {
              "type": "number",
              "description": "Exact two-sided sign test over non-zero per-round differences."
            },
            "median_difference_us": {
              "type": "number",
              "description": "Median per-round difference; negative means the candidate is faster."
            },
            "relative_difference": {
              "type": "number",
              "description": "median_difference_us / baseline median (0 when that is 0)."
            },
            "verdict": {
              "enum": [
                "candidate_faster",
                "candidate_slower",
                "within_spread"
              ],
              "description": "candidate_faster when the whole interval lies below zero, candidate_slower when above, otherwise within_spread: no result."
            },
            "rounds_candidate_faster": {
              "type": "integer"
            },
            "round_count": {
              "type": "integer"
            }
          }
        },
