/*
 * mlx_perf version: generated by CMake from the project() version, so the
 * header, the library and the installed package can never disagree.
 *
 * The C API is the compatibility surface. A minor version adds to it; a
 * major version changes or removes a struct field or a signature. Before
 * 1.0, a minor version may do either, and the release notes say which.
 */
#pragma once

#define MLX_PERF_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MLX_PERF_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MLX_PERF_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MLX_PERF_VERSION_STRING "@PROJECT_VERSION@"
